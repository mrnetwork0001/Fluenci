# ============================================================================
# Fluenci frontend
#
# Copy to `.env.local` for local work, or set these in the Vercel project for
# production. `.env.local` is gitignored.
# ============================================================================

# Backend (AI Sentry / Protect telemetry, QIE Pass KYC, stats, AI chat).
# NOTE: in Vercel this must be ticked for the Preview environment too, or
# preview builds silently lose telemetry, stats and KYC.
VITE_API_URL=https://api.fluenci.xyz

# --- v4 cutover -------------------------------------------------------------
# Setting VITE_REGISTRY_V4_ADDRESS is what flips the whole app from the v1
# dashboard to v2. Leave it blank and production keeps serving v1, which is the
# UI that reads the deployed v3 contracts. Values are printed by deployV4.ts.
VITE_REGISTRY_V4_ADDRESS=
VITE_REPUTATION_ATTESTOR_ADDRESS=

# Streaming token. Blank = QIE mainnet qUSDC. Set this when pointing at a
# local or testnet deploy, whose mock token has a different address.
VITE_QUSDC_ADDRESS=

# Override the RPC v4 is read from. Blank = QIE mainnet.
# Point at http://127.0.0.1:8545 to read a local hardhat deployment.
VITE_V4_RPC_URL=

# QIE Reputation HTTP service. Blank = reputation and wallet flags render an
# explicit "Not available" rather than a fabricated score. Never hardcode this.
VITE_REPUTATION_API_URL=

# --- optional ---------------------------------------------------------------
# Override the v3 registry without a code change.
VITE_REGISTRY_ADDRESS=

# Bypass secret for the pre-launch gate. The default is compiled into the public
# bundle, so set your own if you ever use that gate.
VITE_PREVIEW_SECRET=

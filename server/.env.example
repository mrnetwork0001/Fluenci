# ============================================================================
# Fluenci backend node - gitignored counterpart is server/.env
# ============================================================================
PORT=5001
RPC_URL=https://rpc1mainnet.qie.digital
REGISTRY_ADDRESS=
AUDITOR_ADDRESS=
START_BLOCK=
AI_PRIVATE_KEY=
OPENAI_API_KEY=
QIEPASS_API_URL=https://pass-api.qie.digital
QIEPASS_PUBLIC_KEY=
QIEPASS_SECRET_KEY=
QIEPASS_CLAIMS=firstName

# QIE Reputation (DRS) API + attestation signer.
# DRS_API_KEY is a secret — server-side only, never in the frontend/git.
# REPUTATION_SIGNER_KEY must be the attestor's authorised signer private key.
DRS_API_URL=https://reputation.qie.digital
DRS_API_KEY=
REPUTATION_SIGNER_KEY=
REPUTATION_ATTESTOR_ADDRESS=0x1e89d42C5459b4E8e26b4991DA0f7E0C97CD33B7
REPUTATION_CHAIN_ID=1990
REPUTATION_TTL_DAYS=7

# Admin secret for /configure, /trigger-anomaly, /arbitrate-dispute (fail-closed if unset)
ADMIN_SECRET=

# QIE Pass writes go to the adapter the registry enforces (registry.qiePass()),
# so there is no adapter address to set here. AI_PRIVATE_KEY must be that
# adapter's oracle and hold at least 0.01 QIE, or /qiepass/claim refuses new
# verifications with a 503 (GET /status -> qiePassWriter shows which check
# fails). Credentials QIE accepted but not yet written on-chain are kept in
# server/data/qiepass.json and retried every 5 minutes.

# Extra browser origins allowed to call /api/chat (comma-separated), added to
# https://www.fluenci.xyz, https://fluenci.xyz, http://localhost:5173 and
# http://127.0.0.1:5173. Other routes keep open CORS.
CHAT_ALLOWED_ORIGINS=

# Keep Express in production mode (set it in the pm2 env too).
NODE_ENV=production

# ============================================================================
# Fluenci backend node - gitignored counterpart is server/.env
# ============================================================================
PORT=5001
RPC_URL=https://rpc1mainnet.qie.digital
REGISTRY_ADDRESS=
AUDITOR_ADDRESS=
START_BLOCK=
AI_PRIVATE_KEY=
OPENAI_API_KEY=
# QIE Pass needs QIE's PRODUCTION API and keys: QIEPASS_API_URL exactly
# https://pass-api.qie.digital and a pk_live_ public key. Anything else (QIE's
# sandbox, did-stapi.qie.digital with pk_test_ keys, runs no real document
# checks) is refused: /qiepass/* answer 503 and nothing is written on-chain.
# QIEPASS_ALLOW_SANDBOX=true is for local test chains only. It is ignored on
# QIE mainnet (chain 1990) and while the chain id is unknown. Leave it unset on
# a mainnet server.
QIEPASS_API_URL=https://pass-api.qie.digital
QIEPASS_PUBLIC_KEY=
QIEPASS_SECRET_KEY=
QIEPASS_CLAIMS=firstName

# QIE Reputation (DRS) API + attestation signer.
# DRS_API_KEY is a secret — server-side only, never in the frontend/git.
# REPUTATION_SIGNER_KEY must be the attestor's authorised signer private key.
DRS_API_URL=https://reputation.qie.digital
DRS_API_KEY=
REPUTATION_SIGNER_KEY=
REPUTATION_ATTESTOR_ADDRESS=0x1e89d42C5459b4E8e26b4991DA0f7E0C97CD33B7
REPUTATION_CHAIN_ID=1990
REPUTATION_TTL_DAYS=7

# Admin secret for /configure, /trigger-anomaly, /arbitrate-dispute (fail-closed if unset)
ADMIN_SECRET=

# QIE Pass writes go to the adapter the registry enforces (registry.qiePass()),
# so there is no adapter address to set here. AI_PRIVATE_KEY must be that
# adapter's oracle and hold at least 0.01 QIE, or /qiepass/claim refuses new
# verifications with a 503 (GET /status -> qiePassWriter shows which check
# fails; production: false means the QIE Pass API or key isn't production).
# Credentials QIE accepted but not yet written on-chain are kept in
# server/data/qiepass.json and retried every 5 minutes.

# Extra browser origins allowed to call /api/chat and the Arcade routes
# (/auth/*, /arcade/*), comma-separated, added to https://www.fluenci.xyz,
# https://fluenci.xyz, http://localhost:5173 and http://127.0.0.1:5173.
# Other routes keep open CORS.
CHAT_ALLOWED_ORIGINS=

# Fluenci Arcade (sign-in, server-side Arcade Pass check, Snake leaderboard).
# SESSION_SECRET signs the sign-in tokens (HMAC-SHA256). REQUIRED, at least 32
# characters, e.g. `openssl rand -hex 32`. Without it /auth/*, /arcade/pass,
# /arcade/snake/* and /api/chat answer 503 not_configured. Changing it signs
# everyone out.
SESSION_SECRET=
# The Arcade merchant wallet: the same address as the frontend's
# VITE_ARCADE_MERCHANT. The pass is checked on chain against REGISTRY_ADDRESS.
# Unset, no pass can be valid and /api/chat and Snake scores answer 503.
ARCADE_MERCHANT=
# The site named in the sign-in message (EIP-4361 "domain", and the
# "URI: https://<domain>" line). Wallets compare it with the page that asks for
# the signature, so it must be the host the app is served from. A plain host
# name, no https:// or path. Default www.fluenci.xyz.
# SIGNIN_DOMAIN=www.fluenci.xyz
# TESTS ONLY. Comma-separated token addresses that replace the pass's stablecoin
# allowlist (qUSDC, USDC and USDT bridged from Ethereum) on a local test chain.
# Ignored on QIE mainnet (chain 1990) and while the chain id is unknown. Leave it
# out of a mainnet .env.
# ARCADE_STABLECOINS=

# Keep Express in production mode (set it in the pm2 env too).
NODE_ENV=production

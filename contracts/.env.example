QIE_PASS_ADDRESS=0x98EFC89fA1539B35A6152c35e60BCbbe07a44BbE
# Optional. An auditor is bound to one registry at construction, so on a fresh deploy leave
# this empty and wire a FluenciAIAuditor built for the new registry afterwards.
AI_AUDITOR_ADDRESS=
REQUIRED_MODEL_VERSION=
